{
  "name": "avero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contract-first home maintenance platform workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run fixtures:validate && npm run evaluations:validate",
    "dev:customer": "tsx apps/customer/src/server.ts",
    "dev:provider": "tsx apps/provider/src/server.ts",
    "evaluations:validate": "tsx scripts/validate-ai-evaluations.ts",
    "fixtures:validate": "tsx scripts/validate-fixtures.ts",
    "seed:check": "tsx scripts/seed.ts --check",
    "test": "vitest run",
    "test:integration": "tsx scripts/verify-customer.ts",
    "test:browser": "tsx scripts/verify-customer.ts --browser",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.3.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0"
  }
}
