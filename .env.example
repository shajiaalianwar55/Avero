# Runtime
NODE_ENV=development
CUSTOMER_APP_PORT=3000
PROVIDER_APP_PORT=3001
CUSTOMER_APP_URL=http://localhost:3000
PROVIDER_APP_URL=http://localhost:3001

# Supabase (local defaults; replace public values for hosted environments)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI configuration. Never commit API keys. Keep the snapshot pinned for reproducible evaluations.
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL_DEFAULT=gpt-5.4-mini-2026-03-17
AI_PROMPT_VERSION_A03=a03.v1
AI_PROMPT_VERSION_A04=a04.v1
AI_PROMPT_VERSION_A05=a05.v1
AI_PROMPT_VERSION_A07=a07.v1
AI_PROMPT_VERSION_A10=a10.v1
AI_PROMPT_VERSION_B04=b04.v1
AI_PROMPT_VERSION_B05=b05.v1
AI_PROMPT_VERSION_C03=c03.v1
AI_EVENT_LOG_PATH=var/ai-events.jsonl
