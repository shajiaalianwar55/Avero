# Runtime
NODE_ENV=development
CUSTOMER_APP_PORT=3000
PROVIDER_APP_PORT=3001
CUSTOMER_APP_URL=http://localhost:3000
PROVIDER_APP_URL=http://localhost:3001

# Supabase (local defaults; replace public values for hosted environments)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI configuration is completed by S-02. Never commit API keys.
OPENAI_API_KEY=
AI_EVENT_LOG_PATH=var/ai-events.jsonl
